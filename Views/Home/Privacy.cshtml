<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet Shop - PetGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --brand-teal: #2B6B6C;
                --brand-teal-dark: #1E4D4E;
                --brand-orange: #F27825;
                --brand-bg: #F8F9FA;
                --text-main: #333333;
            }

            body {
                background-color: var(--brand-bg);
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                color: var(--text-main);
            }

            /* Header Logo Padrão */
            .header-logo-container {
                background-color: #FFF;
                padding: 15px 0;
                border-bottom: 1px solid #EAEAEA;
            }

            /* Navegação Padrão */
            .navbar-custom {
                background-color: #E2CDAE;
                border-bottom: 1px solid #D1B896;
            }

                .navbar-custom .nav-link {
                    color: #333 !important;
                    font-weight: 600;
                    padding: 10px 20px !important;
                }

                    .navbar-custom .nav-link.active {
                        background-color: var(--brand-teal);
                        color: #fff !important;
                        border-radius: 4px;
                    }

            /* Banner Principal Pet Shop */
            .hero-petshop {
                background: linear-gradient(rgba(242, 120, 37, 0.85), rgba(43, 107, 108, 0.85)), url('https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1400&q=80') center/cover;
                color: white;
                padding: 70px 0;
                text-align: center;
            }

            /* Botões de Categorias */
            .category-btn {
                background: #ffffff;
                border: 2px solid #EAEAEA;
                border-radius: 50px;
                padding: 10px 22px;
                font-weight: 600;
                color: var(--brand-teal-dark);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s ease;
                box-shadow: 0 2px 5px rgba(0,0,0,0.04);
            }

                .category-btn:hover {
                    background-color: var(--brand-orange);
                    color: #fff;
                    border-color: var(--brand-orange);
                    transform: translateY(-2px);
                }

            /* Card de Produto */
            .product-card {
                background: #fff;
                border: 1px solid #EAEAEA;
                border-radius: 12px;
                padding: 20px;
                text-align: center;
                height: 100%;
                transition: all 0.3s;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .product-card:hover {
                    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
                    transform: translateY(-4px);
                }

                .product-card img {
                    max-height: 150px;
                    object-fit: contain;
                    margin-bottom: 15px;
                }

            .product-badge {
                position: absolute;
                top: 15px;
                left: 15px;
                background-color: var(--brand-orange);
                color: white;
                font-size: 0.75rem;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 20px;
            }

            /* Botão WhatsApp */
            .btn-whatsapp {
                background-color: #25D366;
                color: #fff;
                font-weight: 600;
                border: none;
                border-radius: 25px;
                padding: 8px 16px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                text-decoration: none;
                transition: background 0.3s;
            }

                .btn-whatsapp:hover {
                    background-color: #1EBE5D;
                    color: #fff;
                }

            footer {
                background-color: #1A1D20;
                color: #D3D3D3;
                padding: 40px 0 20px;
            }
    </style>
</head>
<body>

    <!-- Header Logo Padrão -->
    <header class="header-logo-container">
        <div class="container text-center">
            <div class="d-inline-flex align-items-center">
                <i class="fa-solid fa-dog fa-3x me-2" style="color: var(--brand-orange);"></i>
                <h1 class="m-0 fw-bold" style="font-size: 2.8rem;">
                    <span style="color: var(--brand-teal);">Pet</span><span style="color: var(--brand-orange);">Go</span>
                </h1>
            </div>
        </div>
    </header>

    <!-- Menu de Navegação Padrão -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container justify-content-center">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav"
            </div>
        </div>
    </nav>

    <!-- Banner Pet Shop -->
    <section class="hero-petshop">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Pet Shop PetGo</h1>
            <p class="fs-5 max-w-700 mx-auto">Tudo o que o seu pet precisa em um só lugar. Rações premium, brinquedos interativos, acessórios e petiscos deliciosos!</p>
        </div>
    </section>

    <!-- Categorias do Pet Shop -->
    <section class="container my-5" id="petshop">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: var(--brand-teal-dark);">Explore por Categoria</h2>
            <p class="text-muted">Clique na categoria para filtrar os melhores produtos para cães e gatos</p>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
            <a href="#brinquedos" class="category-btn"><i class="fa-solid fa-bone text-warning"></i> Brinquedos</a>
            <a href="#comida" class="category-btn"><i class="fa-solid fa-bowl-food text-warning"></i> Comida & Rações</a>
            <a href="#coleiras" class="category-btn"><i class="fa-solid fa-vest text-warning"></i> Coleiras & Guias</a>
            <a href="#petiscos" class="category-btn"><i class="fa-solid fa-cookie-bite text-warning"></i> Petiscos</a>
            <a href="#higiene" class="category-btn"><i class="fa-solid fa-soap text-warning"></i> Higiene & Cuidados</a>
            <a href="#camas" class="category-btn"><i class="fa-solid fa-bed text-warning"></i> Camas & Acessórios</a>
        </div>

        <!-- Vitrine de Produtos -->
        <div class="row g-4">

            <!-- Comida / Rações -->
            <div class="col-6 col-md-4 col-lg-3" id="comida">
                <div class="product-card position-relative">
                    <span class="product-badge">Mais Vendido</span>
                    <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=300&q=80" alt="Ração Premium" class="img-fluid">
                    <div>
                        <small class="text-muted">Rações & Comida</small>
                        <h6 class="fw-bold my-1">Ração Super Premium Cães Adultos 15kg</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 189,90</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20a%20Ração%20Super%20Premium" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Brinquedos -->
            <div class="col-6 col-md-4 col-lg-3" id="brinquedos">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=300&q=80" alt="Brinquedo Mordedor" class="img-fluid">
                    <div>
                        <small class="text-muted">Brinquedos</small>
                        <h6 class="fw-bold my-1">Mordedor Resistente de Borracha Atóxica</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 34,90</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20o%20Mordedor%20Resistente" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Coleiras -->
            <div class="col-6 col-md-4 col-lg-3" id="coleiras">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=300&q=80" alt="Kit Coleira e Guia" class="img-fluid">
                    <div>
                        <small class="text-muted">Coleiras & Guias</small>
                        <h6 class="fw-bold my-1">Kit Peitoral Ergonômico + Guia Refletiva</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 79,90</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20o%20Kit%20Peitoral" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Petiscos -->
            <div class="col-6 col-md-4 col-lg-3" id="petiscos">
                <div class="product-card position-relative">
                    <span class="product-badge">Oferta</span>
                    <img src="https://images.unsplash.com/photo-1582798358481-d199fb7347bb?auto=format&fit=crop&w=300&q=80" alt="Petisco Natural" class="img-fluid">
                    <div>
                        <small class="text-muted">Petiscos</small>
                        <h6 class="fw-bold my-1">Biscoitos Naturais Crocantes 500g</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 22,50</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20os%20Biscoitos%20Naturais" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Camas & Acessórios -->
            <div class="col-6 col-md-4 col-lg-3" id="camas">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1592194996308-7b43878e84a6?auto=format&fit=crop&w=300&q=80" alt="Cama Pet Ortopédica" class="img-fluid">
                    <div>
                        <small class="text-muted">Camas & Acessórios</small>
                        <h6 class="fw-bold my-1">Cama Confort Ortopédica Lavável Tam G</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 219,00</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20a%20Cama%20Confort" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Higiene & Cuidados -->
            <div class="col-6 col-md-4 col-lg-3" id="higiene">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1583947215259-38e31be8751f?auto=format&fit=crop&w=300&q=80" alt="Shampoo Neutro Pet" class="img-fluid">
                    <div>
                        <small class="text-muted">Higiene & Cuidados</small>
                        <h6 class="fw-bold my-1">Shampoo Neutro Hipoalergênico 500ml</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 38,00</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20o%20Shampoo%20Neutro" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Brinquedos Gatos -->
            <div class="col-6 col-md-4 col-lg-3">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1545249390-6bdfa286032f?auto=format&fit=crop&w=300&q=80" alt="Arranhador Torre para Gatos" class="img-fluid">
                    <div>
                        <small class="text-muted">Brinquedos & Arranhadores</small>
                        <h6 class="fw-bold my-1">Arranhador Torre 2 Andares para Gatos</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 149,90</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20o%20Arranhador%20Torre" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

            <!-- Comida Gatos -->
            <div class="col-6 col-md-4 col-lg-3">
                <div class="product-card position-relative">
                    <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=300&q=80" alt="Ração para Gatos" class="img-fluid">
                    <div>
                        <small class="text-muted">Rações & Comida</small>
                        <h6 class="fw-bold my-1">Ração Premier Gatos Castrados 7.5kg</h6>
                        <div class="text-success fs-5 fw-bold mb-3">R$ 142,00</div>
                    </div>
                    <a href="https://wa.me/5511987654321?text=Olá,%20gostaria%20de%20comprar%20a%20Ração%20Premier%20Gatos" class="btn btn-whatsapp w-100"><i class="fa-brands fa-whatsapp"></i> Comprar</a>
                </div>
            </div>

        </div>
    </section>

    <!-- Rodapé -->
    <footer id="contato">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <h5 class="text-white fw-bold mb-3">PetGo - Pet Shop & Clínica</h5>
                    <p class="small text-secondary mb-2"><i class="fa-solid fa-location-dot me-2 text-warning"></i> Rua dos Pets Felizes, 123 - São Paulo/SP</p>
                    <p class="small text-secondary mb-2"><i class="fa-solid fa-phone me-2 text-warning"></i> (11) 98765-4321</p>
                    <p class="small text-secondary m-0"><i class="fa-solid fa-envelope me-2 text-warning"></i> petshop@petgo.com.br</p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <h5 class="text-white fw-bold mb-3">Horário de Funcionamento</h5>
                    <p class="small text-secondary mb-1">Loja Pet Shop: Seg a Sáb, das 08h às 20h | Dom: 09h às 16h</p>
                    <p class="small text-warning fw-bold">Entregas e Delivery: Atendimento Rápido via WhatsApp</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center small text-secondary">
                © 2026 PetGo Pet Shop. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>