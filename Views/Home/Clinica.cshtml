<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clínica Veterinária - PetGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --brand-teal: #2B6B6C;
                --brand-teal-dark: #1E4D4E;
                --brand-orange: #F27825;
                --brand-bg: #F8F9FA;
                --text-main: #333333;
            }

            body {
                background-color: var(--brand-bg);
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                color: var(--text-main);
            }

            /* Header Logo */
            .header-logo-container {
                background-color: #FFF;
                padding: 15px 0;
                border-bottom: 1px solid #EAEAEA;
            }

            /* Topo e Navegação Padrão */
            .navbar-custom {
                background-color: #E2CDAE;
                border-bottom: 1px solid #D1B896;
            }

                .navbar-custom .nav-link {
                    color: #333 !important;
                    font-weight: 600;
                    padding: 10px 20px !important;
                }

                    .navbar-custom .nav-link.active {
                        background-color: var(--brand-teal);
                        color: #fff !important;
                        border-radius: 4px;
                    }

            /* Banner Principal da Clínica */
            .hero-clinic {
                background: linear-gradient(rgba(30, 77, 78, 0.8), rgba(30, 77, 78, 0.8)), url('https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1400&q=80') center/cover;
                color: white;
                padding: 80px 0;
                text-align: center;
            }

            /* Cards Médicos */
            .clinic-card {
                background: #ffffff;
                border: none;
                border-radius: 12px;
                padding: 30px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                height: 100%;
                transition: transform 0.3s;
            }

                .clinic-card:hover {
                    transform: translateY(-5px);
                }

            .clinic-icon {
                font-size: 2.5rem;
                color: var(--brand-teal);
                margin-bottom: 15px;
            }

            /* Alerta de Emergência */
            .emergency-banner {
                background-color: #dc3545;
                color: white;
                border-radius: 12px;
                padding: 25px;
            }

            /* Estilização da Equipe */
            .team-img {
                width: 120px;
                height: 120px;
                object-fit: cover;
                border-radius: 50%;
                border: 4px solid var(--brand-teal);
                margin-bottom: 15px;
            }

            /* Depoimentos */
            .testimonial-card {
                background: #fff;
                border-radius: 12px;
                padding: 20px;
                border: 1px solid #EAEAEA;
                box-shadow: 0 2px 8px rgba(0,0,0,0.03);
                height: 100%;
            }

            .stars {
                color: #FFC107;
                margin-bottom: 10px;
            }

            /* Botões */
            .btn-agendar {
                background-color: var(--brand-teal);
                color: white;
                font-weight: 700;
                padding: 12px 30px;
                border-radius: 25px;
                text-decoration: none;
                transition: background-color 0.3s;
            }

                .btn-agendar:hover {
                    background-color: var(--brand-teal-dark);
                    color: white;
                }

            footer {
                background-color: #1A1D20;
                color: #D3D3D3;
                padding: 40px 0 20px;
            }
    </style>
</head>
<body>

    <!-- Header Logo Padrão -->
    <header class="header-logo-container">
        <div class="container text-center">
            <div class="d-inline-flex align-items-center">
                <i class="fa-solid fa-dog fa-3x me-2" style="color: var(--brand-orange);"></i>
                <h1 class="m-0 fw-bold" style="font-size: 2.8rem;">
                    <span style="color: var(--brand-teal);">Pet</span><span style="color: var(--brand-orange);">Go</span>
                </h1>
            </div>
        </div>
    </header>

    <!-- Menu de Navegação Padrão -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container justify-content-center">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav"
            </div>
        </div>
    </nav>

    <!-- Banner Principal da Clínica -->
    <section class="hero-clinic" id="clinica">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Clínica Veterinária PetGo</h1>
            <p class="fs-5 max-w-700 mx-auto mb-4">Cuidado médico humanizado, equipamentos modernos e corpo clínico altamente especializado para o seu melhor amigo.</p>
            <a href="#agendar-consulta" class="btn btn-agendar btn-lg"><i class="fa-brands fa-whatsapp me-2"></i>Agendar Consulta Veterinária</a>
        </div>
    </section>

    <!-- Alerta de Emergência -->
    <section class="container my-5">
        <div class="emergency-banner d-md-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center mb-3 mb-md-0">
                <i class="fa-solid fa-truck-medical fa-3x me-3"></i>
                <div>
                    <h4 class="m-0 fw-bold">Atendimento de Emergência 24h</h4>
                    <p class="m-0">Se o seu pet precisa de cuidados imediatos, estamos prontos para atender.</p>
                </div>
            </div>
            <a href="tel:11987654321" class="btn btn-light btn-lg fw-bold text-danger text-nowrap"><i class="fa-solid fa-phone me-2"></i>Ligar Agora</a>
        </div>
    </section>

    <!-- Especialidades / Serviços Médicos -->
    <section class="container my-5" id="especialidades">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: var(--brand-teal-dark);">Nossos Serviços e Especialidades</h2>
            <p class="text-muted">Acompanhamento completo em diversas áreas da medicina veterinária.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-heart-pulse clinic-icon"></i>
                    <h4 class="fw-bold">Cardiologia</h4>
                    <p class="text-muted small">Avaliação preventiva e acompanhamento de doenças cardíacas com exames de ecocardiograma e eletrocardiograma.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-bone clinic-icon"></i>
                    <h4 class="fw-bold">Ortopedia</h4>
                    <p class="text-muted small">Diagnóstico e cirurgias avançadas para problemas articulares, fraturas e mobilidade do animal.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-microscope clinic-icon"></i>
                    <h4 class="fw-bold">Dermatologia</h4>
                    <p class="text-muted small">Tratamento de alergias, infecções de pele e problemas dermatológicos recorrentes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-tooth clinic-icon"></i>
                    <h4 class="fw-bold">Odontologia</h4>
                    <p class="text-muted small">Tratamento periodontal, limpeza de tártaro e cirurgias bucais para manter a saúde oral do pet em dia.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-x-ray clinic-icon"></i>
                    <h4 class="fw-bold">Exames de Imagem</h4>
                    <p class="text-muted small">Raio-X digital e Ultrassonografia na própria clínica para diagnósticos rápidos e precisos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="clinic-card text-center">
                    <i class="fa-solid fa-syringe clinic-icon"></i>
                    <h4 class="fw-bold">Imunização & Vacinas</h4>
                    <p class="text-muted small">Protocolos vacinais atualizados e individualizados com vacinas importadas e seguras.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Corpo Médico / Equipe -->
    <section class="bg-white py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold" style="color: var(--brand-teal-dark);">Nossa Equipe Médica</h2>
                <p class="text-muted">Profissionais dedicados e apaixonados pela saúde animal.</p>
            </div>

            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=300&q=80" alt="Dr. Ricardo Silva" class="team-img">
                    <h5 class="fw-bold m-0">Dr. Ricardo Silva</h5>
                    <p class="text-muted small mb-2">CRMV-SP 12345 | Clínico Geral & Cirurgião</p>
                    <p class="small text-secondary">Especialista em cirurgias de tecidos moles e atendimento de emergência.</p>
                </div>
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1594824813566-88855ce78906?auto=format&fit=crop&w=300&q=80" alt="Dra. Camila Santos" class="team-img">
                    <h5 class="fw-bold m-0">Dra. Camila Santos</h5>
                    <p class="text-muted small mb-2">CRMV-SP 67890 | Dermatologia</p>
                    <p class="small text-secondary">Foco no diagnóstico de alergias alimentares e tratamentos de pele contínuos.</p>
                </div>
                <div class="col-md-4">
                    <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=300&q=80" alt="Dr. André Costa" class="team-img">
                    <h5 class="fw-bold m-0">Dr. André Costa</h5>
                    <p class="text-muted small mb-2">CRMV-SP 54321 | Cardiologia</p>
                    <p class="small text-secondary">Atuação preventiva na saúde cardíaca de pets idosos e exames pré-operatórios.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Depoimentos -->
    <section class="py-5 container" id="depoimentos">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: var(--brand-teal-dark);">Depoimentos dos Nossos Pacientes</h3>
            <p class="text-muted">A satisfação dos tutores e a saúde dos pets são nosso compromisso.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                    <p class="small text-secondary mb-3">"A equipe médica foi fantástica no atendimento da minha cadelinha. Diagnóstico rápido e tratamento impecável!"</p>
                    <div class="fw-bold small">— Mariana & Thor</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                    <p class="small text-secondary mb-3">"Atendimento de emergência nota 10! Salvaram meu gatinho no meio da noite. Gratidão a todos os veterinários."</p>
                    <div class="fw-bold small">— Carlos & Mia</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                    <p class="small text-secondary mb-3">"Faço o acompanhamento dermatológico do meu pet aqui e a melhora dele foi incrível. Clínica muito limpa e organizada."</p>
                    <div class="fw-bold small">— Fernanda & Bidu</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulário de Agendamento -->
    <section class="container my-5" id="agendar-consulta">
        <div class="bg-light p-4 p-md-5 rounded-3 border">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h3 class="fw-bold mb-3" style="color: var(--brand-teal-dark);">Solicite um Agendamento</h3>
                    <p class="text-muted">Preencha os dados e entraremos em contato rapidamente para confirmar o melhor horário para o seu pet.</p>
                    <div class="d-flex align-items-center gap-3 text-secondary mb-2">
                        <i class="fa-solid fa-clock text-warning"></i>
                        <span>Atendimento com hora marcada</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-secondary">
                        <i class="fa-solid fa-shield-cat text-warning"></i>
                        <span>Ambiente preparado para cães e gatos</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <form>
                        <div class="mb-3">
                            <input type="text" class="form-control" placeholder="Seu nome completo" required>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <input type="tel" class="form-control" placeholder="Seu Telefone/WhatsApp" required>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control" placeholder="Nome do seu Pet" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <select class="form-select">
                                <option selected disabled>Selecione o serviço necessário</option>
                                <option>Consulta Clínica Geral</option>
                                <option>Vacinação</option>
                                <option>Consulta Especializada</option>
                                <option>Exames de Imagem / Laboratório</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-agendar w-100 border-0">Enviar Solicitação</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Rodapé -->
    <footer id="contato">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <h5 class="text-white fw-bold mb-3">PetGo - Clínica Veterinária</h5>
                    <p class="small text-secondary mb-2"><i class="fa-solid fa-location-dot me-2 text-warning"></i> Rua dos Pets Felizes, 123 - São Paulo/SP</p>
                    <p class="small text-secondary mb-2"><i class="fa-solid fa-phone me-2 text-warning"></i> (11) 98765-4321</p>
                    <p class="small text-secondary m-0"><i class="fa-solid fa-envelope me-2 text-warning"></i> clinica@petgo.com.br</p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <h5 class="text-white fw-bold mb-3">Horário da Clínica</h5>
                    <p class="small text-secondary mb-1">Consultas de Rotina: Seg a Sáb, das 08h às 20h</p>
                    <p class="small text-danger fw-bold">Pronto-Socorro / Emergências: 24 Horas</p>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center small text-secondary">
                © 2026 PetGo Clínica Veterinária. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>