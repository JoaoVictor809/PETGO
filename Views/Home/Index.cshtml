                        <li><i class="fa-solid fa-check"></i> Corte de unhas e limpeza de ouvido</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-box icon-orange">
                        <i class="fa-solid fa-van-shuttle"></i>
                    </div>
